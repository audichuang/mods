#!/usr/bin/env bash
# Wait for a GitHub Actions run or a PR's checks without burning the REST quota.
# Uses ETag conditional requests: a 304 (nothing changed) does not count against
# the 5000/hr limit, so only actual state changes cost a request.
#
#   gh-wait run <run-id> [-R owner/repo] [-i seconds] [-t timeout-minutes]
#   gh-wait pr  <number> [-R owner/repo] [-i seconds] [-t timeout-minutes]
#
# pr waits for the head commit's check runs, then for every check suite that has runs
# (a job with needs: gets its check run only after the jobs it needs finish).
#
# Exit: 0 success, 1 finished but failed, 2 usage/API error or timeout (default 120 min).
# Needs gh and jq.
set -uo pipefail

usage() { sed -n 's/^#   //p' "$0" >&2; exit 2; }
[ $# -ge 2 ] || usage
kind=$1 target=$2; shift 2
repo='' interval=15 timeout=120
while [ $# -gt 0 ]; do
    [ $# -ge 2 ] || usage
    case $1 in
        -R|--repo) repo=$2; shift 2 ;;
        -i|--interval) interval=$2; shift 2 ;;
        -t|--timeout) timeout=$2; shift 2 ;;
        *) usage ;;
    esac
done
[[ $interval =~ ^[1-9][0-9]*$ && $timeout =~ ^[1-9][0-9]*$ ]] || usage
command -v jq >/dev/null || { echo 'gh-wait: jq is required (brew install jq / apt install jq)' >&2; exit 2; }
[ -n "$repo" ] || repo=$(gh repo view --json nameWithOwner -q .nameWithOwner) || exit 2

case $kind in
    run)
        path="repos/$repo/actions/runs/$target"
        # done: completed; ok: conclusion is success
        jq_state='if .status == "completed" then (if .conclusion == "success" then "ok" else "fail:" + .conclusion end) else "wait:" + .status end'
        ;;
    pr)
        sha=$(gh api "repos/$repo/pulls/$target" -q .head.sha) || exit 2
        path="repos/$repo/commits/$sha/check-runs?per_page=100"
        jq_state='.check_runs as $c
            | if ($c | length) == 0 then "wait:no checks yet"
              elif any($c[]; .status != "completed") then "wait:\([$c[] | select(.status != "completed")] | length) running (\([$c[] | select(.status != "completed") | .name] | join(", ")))"
              elif all($c[]; .conclusion == "success" or .conclusion == "skipped" or .conclusion == "neutral") then "ok"
              else "fail:" + ([$c[] | select(.conclusion != "success" and .conclusion != "skipped" and .conclusion != "neutral") | .name] | join(", ")) end'
        ;;
    *) usage ;;
esac

# hdr <name>: a response header's value (case-insensitive name).
hdr() {
    awk -v k="$1" 'NR > 1 && /^\r?$/ {exit}
        {i = index($0, ":"); if (i && tolower(substr($0, 1, i - 1)) == tolower(k)) {v = substr($0, i + 1); gsub(/^ +|\r/, "", v); print v; exit}}' <<<"$resp"
}
# suites_done: every check suite of $sha that has check runs is completed and none failed.
# Otherwise sets $suites to a wait: state and returns 1. A suite that failed after the check-runs
# read means that snapshot is stale: wait, and the next poll re-reads the runs and reports the
# failure by name. A failed request counts as not done (retried next poll, at most 5 in a row),
# except gh not logged in or 401/404/422, which stop like the main request does.
suites_done() {
    local out rc code body
    out=$(gh api -i "repos/$repo/commits/$sha/check-suites?per_page=100" 2>"$errf")
    rc=$?
    code=$(head -1 <<<"$out" | awk '{print $2}' | tr -d '\r')
    if [ "$code" = 200 ]; then
        body=$(awk 'f; /^\r?$/ {f=1}' <<<"$out")
        suite_errors=0
        suites=$(jq -r '[.check_suites[]? | select(.latest_check_runs_count > 0)] as $s
            | [$s[] | select(.status != "completed")] as $running
            | if ($running | length) > 0 then "wait:\($running | length) workflow still running (\([$running[] | .app.name // "?"] | unique | join(", ")))"
              elif any($s[]; .conclusion != "success" and .conclusion != "skipped" and .conclusion != "neutral") then "wait:a workflow finished after the check-runs read, re-reading"
              else "ok" end' <<<"$body") || exit 2
        [ "$suites" = ok ]
        return
    fi
    local err
    err=$(head -3 "$errf" | tr '\r\n' '  ' | sed 's/ *$//')
    if [ -z "$code" ] && { [ $rc -eq 4 ] || grep -qiE 'gh auth login|not logged in' "$errf"; }; then
        echo "$(date +%H:%M:%S) gh is not logged in: ${err:-gh exited 4}" >&2
        exit 2
    fi
    case $code in
        401|404|422)
            echo "$(date +%H:%M:%S) HTTP $code for check-suites${err:+: $err}" >&2
            exit 2
            ;;
    esac
    local what=${code:+HTTP $code}
    suite_errors=$((suite_errors + 1))
    echo "$(date +%H:%M:%S) check-suites: ${what:-gh api failed} (attempt $suite_errors): ${err:-gh exited $rc}" >&2
    [ $suite_errors -ge 5 ] && exit 2
    suites='wait:checking workflows'
    return 1
}
errf=$(mktemp) || exit 2
trap 'rm -f "$errf"' EXIT
etag='' last='' errors=0 suite_errors=0 changed=$SECONDS beat=$SECONDS
# GH_WAIT_MINUTE (seconds per -t minute) only exists so tests can time out quickly.
deadline=$((SECONDS + timeout * ${GH_WAIT_MINUTE:-60}))
while :; do
    if [ $SECONDS -ge $deadline ]; then
        echo "$(date +%H:%M:%S) timeout after ${timeout} min, last state: ${last:-unknown}" >&2
        exit 2
    fi
    resp=$(gh api -i ${etag:+-H "If-None-Match: $etag"} "$path" 2>"$errf")
    rc=$?
    code=$(head -1 <<<"$resp" | awk '{print $2}' | tr -d '\r')
    err=$(head -3 "$errf" | tr '\r\n' '  ' | sed 's/ *$//')
    # Primary rate limit used up: wait for the reset (bounded by the deadline), not an error.
    if [[ $code =~ ^(403|429)$ ]] && [ "$(hdr X-Ratelimit-Remaining)" = 0 ]; then
        reset=$(hdr X-Ratelimit-Reset)
        [[ $reset =~ ^[0-9]+$ ]] || reset=$(($(date +%s) + 60))
        pause=$((reset - $(date +%s) + 1)) left=$((deadline - SECONDS))
        [ $pause -gt $left ] && pause=$left
        [ $pause -lt 1 ] && pause=1
        echo "$(date +%H:%M:%S) rate limit used up, waiting ${pause}s for the reset" >&2
        sleep $pause
        continue
    fi
    case $code in
        304) errors=0 ;;
        401|404|422)
            echo "$(date +%H:%M:%S) HTTP $code for $path${err:+: $err}" >&2
            exit 2
            ;;
        200)
            errors=0
            etag=$(hdr ETag)
            state=$(awk 'f; /^\r?$/ {f=1}' <<<"$resp" | jq -r "$jq_state") || exit 2
            # pr: a job with needs: has no check run until the jobs it needs finish, so all-green
            # runs can still have a workflow running. Ask the check suites once, only now.
            if [ "$state" = ok ] && [ "$kind" = pr ] && ! suites_done; then
                state=$suites
                # Forget the ETag: unchanged check runs would answer 304 and never get here again.
                etag=''
            fi
            if [ "$state" != "$last" ]; then
                echo "$(date +%H:%M:%S) $state"
                changed=$SECONDS beat=$SECONDS
            fi
            last=$state
            case $state in
                ok) exit 0 ;;
                fail:*)
                    if [ "$kind" = run ]; then
                        gh api "$path/jobs?per_page=100" -q '[.jobs[] | select(.conclusion != "success" and .conclusion != "skipped") | "\(.name) (\(.conclusion))"] | "failed jobs: " + join(", ")' 2>/dev/null
                    fi
                    exit 1
                    ;;
            esac
            ;;
        *)
            # No HTTP response at all: gh failed before the request (auth) or on the way (network).
            if [ -z "$code" ] && { [ $rc -eq 4 ] || grep -qiE 'gh auth login|not logged in' "$errf"; }; then
                echo "$(date +%H:%M:%S) gh is not logged in: ${err:-gh exited 4}" >&2
                exit 2
            fi
            errors=$((errors + 1))
            what=${code:+HTTP $code}
            echo "$(date +%H:%M:%S) ${what:-gh api failed} (attempt $errors): ${err:-gh exited $rc}" >&2
            [ $errors -ge 5 ] && exit 2
            sleep $((interval * errors))
            continue
            ;;
    esac
    # State unchanged (304, or 200 with the same state). Say so every 5 min, so a stuck check is visible.
    if [ $((SECONDS - beat)) -ge "${GH_WAIT_BEAT:-300}" ]; then
        echo "$(date +%H:%M:%S) unchanged for $(((SECONDS - changed) / 60)) min: $last"
        beat=$SECONDS
    fi
    sleep "$interval"
done
